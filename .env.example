# Copy to .env.local and fill in. Never commit .env.local.
# PRD section 7, plus two additions noted below.

# --- Supabase ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by webhooks and the automation runner.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The dedicated number, E.164 (e.g. +15551234567).
TWILIO_PHONE_NUMBER=
# Not in PRD section 7. Added in step 2: inbound calls are forwarded here.
TWILIO_FORWARD_TO_NUMBER=+15145818570

# --- Form webhook (step 4) ---
# Not in PRD section 7. Shared secret for POST /api/webhooks/form, which has no
# signature to verify and can trigger an SMS to any number posted to it. The
# route returns 503 while this is unset rather than accepting anonymous
# submissions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FORM_WEBHOOK_SECRET=

# --- App ---
# Not in PRD section 7. Optional for Twilio, but NOT optional once bookings are
# live: it is the origin the cancel links in confirmation texts and emails are
# built from, and they are dropped from the message entirely when it is unset.
# Your ngrok URL locally, the deployment URL in production, no trailing slash.
# Leave blank to derive it from forwarded headers for signature verification,
# which works under both ngrok and Vercel.
APP_BASE_URL=

# --- Booking reminders cron ---
# Not in PRD section 7. Shared secret for GET /api/cron/booking-reminders.
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET` automatically
# once this is set on the project, so setting it is the whole configuration.
# The route returns 503 while it is unset: unprotected, that endpoint lets a
# stranger text every client with an upcoming meeting, on your Twilio account.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# The schedule lives in vercel.json and is every 15 minutes, which Vercel only
# permits on Pro — Hobby projects are limited to one run per day. On Hobby,
# change it to "0 9 * * *" and accept that the ~1h reminder will rarely fire.
CRON_SECRET=

# --- Anthropic (step 7) ---
ANTHROPIC_API_KEY=

# --- Resend (notification email) ---
# Powers the `notify_me` automation action and the AI hand-off alert. Both
# degrade to a log line when this is unset — an alert never fails the thing it
# is reporting on. Get a key from resend.com > API Keys.
#
# PERMISSION MATTERS. A "sending access" key can send email and nothing else:
# every domain endpoint returns 401 with name `restricted_api_key`. The Email
# Services page needs to create, verify and list domains, and to read send
# activity, so it needs a **Full access** key. If the page tells you the key is
# send-only, that is this — mint a new key with Full access and replace this
# value. Sending itself works either way.
RESEND_API_KEY=
# Optional, and no longer the source of truth. The sending domain chosen on
# Email Services is stored in the database and wins over this; it remains as a
# fallback for deployments that set it before that page existed. Unset and with
# no domain chosen, mail goes out from Resend's shared sender, which only
# delivers to the address the Resend account was registered with — i.e. it
# silently does not reach clients.
NOTIFY_FROM_EMAIL=

# Signing secret for POST /api/webhooks/resend, which receives delivery, open,
# bounce and spam-complaint events and drives the "Email events" automation
# trigger. Resend > Webhooks > add an endpoint pointing at
# {APP_BASE_URL}/api/webhooks/resend, then copy its signing secret here — it
# starts `whsec_`.
#
# The route returns 503 while this is unset rather than trusting what it is
# sent. Unverified, that URL is somewhere a stranger can post a fake bounce and
# drive whatever rules are attached to one.
RESEND_WEBHOOK_SECRET=

# --- Browser calling (the dialer in the top bar) -----------------------------
# All three, or the dialer stays disabled and says so. The rest of the app is
# unaffected — these are the only things browser calling needs beyond the
# account credentials above.
#
# TWILIO_API_KEY_SID / SECRET: Console → Account → API keys & tokens → Standard
#   key. The secret is shown once, at creation.
# TWILIO_TWIML_APP_SID: Console → Voice → TwiML → TwiML Apps. Its Voice
#   "Request URL" must be {APP_BASE_URL}/api/webhooks/twilio/voice/outbound
#   with method POST.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# --- Billing (client balances) ---
# `simulated` (default) or `stripe`. Simulated top-ups credit the real ledger
# without charging anything, which is how the whole flow is exercised before a
# Stripe account exists — the confirm screen says so in two places and asks for
# no card details.
#
# Setting this to `stripe` before the integration is written makes top-ups fail
# with an explanation rather than quietly crediting for free, which is the one
# way this could go wrong that costs real money.
BILLING_MODE=simulated

# --- Payments (a client's own Stripe account) ---
# Not the same thing as BILLING_MODE above. That one is the wallet clients top
# up to buy texts and minutes from us. These are for reading the client's *own*
# Stripe account, which holds their revenue and never passes through us.
#
# No client ever supplies a key. They approve a read-only OAuth connection on
# Stripe's own screen, and every request afterwards is made with the platform
# key below plus a Stripe-Account header naming their account.
#
# STRIPE_CLIENT_ID: Stripe Dashboard → Settings → Connect → Onboarding options
#   → OAuth. Starts `ca_`. Register the redirect URI there as
#   {origin}/api/payments/stripe/callback — for EVERY origin you use. The
#   redirect URI is taken from the request, not from APP_BASE_URL, so testing
#   locally needs http://localhost:3000/api/payments/stripe/callback
#   registered too. Verified 20 Aug 2026: Stripe rejects an unregistered URI
#   up front, before the approval screen, with "Invalid redirect URI … Ensure
#   this uri exactly matches one of the uris specified in your application
#   settings". Exact match — scheme, port and path all count.
#   Test and live are different client ids.
# STRIPE_SECRET_KEY: the platform account's own secret key (`sk_`). Used to
#   exchange the authorization code and to sign every read. Never a client's.
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=

# Optional. Signs the CSRF state that ties an OAuth callback to the browser
# that started it. Falls back to STRIPE_SECRET_KEY when unset — a separate
# secret is tidier, an absent one would disable the check silently.
STRIPE_CONNECT_STATE_SECRET=
